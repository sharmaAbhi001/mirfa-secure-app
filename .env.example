# Master Key (32 bytes in hex format) - KEEP THIS SECRET!
# Generate a new one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Neon DB PostgreSQL Connection
# Step 1: Sign up at https://console.neon.tech
# Step 2: Create a new project and database
# Step 3: Copy the connection string from the Neon dashboard
# Format: postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require"
